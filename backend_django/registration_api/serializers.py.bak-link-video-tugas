        biodata = self.get_registration_biodata(obj)

        return (
            biodata.get('program')
            or biodata.get('program_paket')
            or biodata.get('paket')
            or ''
        )

    def get_siswa_kelas(self, obj):
        biodata = self.get_registration_biodata(obj)

        return (
            biodata.get('rombel_nama')
            or biodata.get('kelas')
            or ''
