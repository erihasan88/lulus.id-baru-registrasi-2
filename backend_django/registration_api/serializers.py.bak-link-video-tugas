            'nama_ujian',
            'jenis_ujian',
            'soal',
            'soal_detail',
            'jumlah_soal',
            'durasi_menit',
            'nilai_minimum',
            'tanggal_mulai',
            'tanggal_selesai',
            'acak_soal',
            'acak_jawaban',
            'tampilkan_nilai',
            'status',
            'created_at',
            'updated_at',
        ]
        read_only_fields = [
            'id',
            'guru',
            'guru_nama',
            'mata_pelajaran_nama',
            'rombel_nama',
            'fase',
            'program',
            'sistem_belajar',
            'semester',
            'tahun_ajaran',
            'soal_detail',
            'jumlah_soal',
            'created_at',
            'updated_at',
        ]

    def get_jumlah_soal(self, obj):
        return obj.soal.count()

    def validate(self, attrs):
        request = self.context.get('request')

        mata_pelajaran = attrs.get(
            'mata_pelajaran',
            getattr(self.instance, 'mata_pelajaran', None)
        )
        rombel = attrs.get(
            'rombel',
            getattr(self.instance, 'rombel', None)
        )
        soal = attrs.get(
            'soal',
            list(self.instance.soal.all())
            if self.instance else []
        )
        tanggal_mulai = attrs.get(
            'tanggal_mulai',
            getattr(self.instance, 'tanggal_mulai', None)
        )
        tanggal_selesai = attrs.get(
            'tanggal_selesai',
            getattr(self.instance, 'tanggal_selesai', None)
        )
        nilai_minimum = attrs.get(
            'nilai_minimum',
            getattr(self.instance, 'nilai_minimum', 70)
        )

        if tanggal_mulai and tanggal_selesai:
            if tanggal_selesai <= tanggal_mulai:
                raise serializers.ValidationError({
                    'tanggal_selesai':
                        'Tanggal selesai harus setelah tanggal mulai.'
                })

        if nilai_minimum < 0 or nilai_minimum > 100:
            raise serializers.ValidationError({
                'nilai_minimum':
                    'Nilai minimum harus antara 0 sampai 100.'
            })

        if not soal:
            raise serializers.ValidationError({
                'soal':
                    'Minimal satu soal harus dipilih.'
            })

        guru_login = getattr(
            request.user,
            'teacher_profile',
            None
        ) if request else None

        for item in soal:
            if guru_login and item.guru_id != guru_login.id:
                raise serializers.ValidationError({
                    'soal':
                        'Terdapat soal yang bukan milik guru yang sedang masuk.'
                })

            if mata_pelajaran and item.mata_pelajaran_id != mata_pelajaran.id:
                raise serializers.ValidationError({
                    'soal':
                        'Semua soal harus berasal dari mata pelajaran yang sama.'
                })

            if rombel and item.rombel_id != rombel.id:
                raise serializers.ValidationError({
                    'soal':
                        'Semua soal harus berasal dari rombel yang sama.'
                })

        return attrs


