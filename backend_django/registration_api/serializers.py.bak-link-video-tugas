class StudentRegistrationSerializer(serializers.ModelSerializer):
    user_id = serializers.IntegerField(source='user.id', read_only=True)
    invoice = PaymentInvoiceSerializer(read_only=True)
    rejection_logs = RejectionLogSerializer(many=True, read_only=True)
    username = serializers.ReadOnlyField(source='user.username')
    email = serializers.ReadOnlyField(source='user.email')

    # Format tambahan untuk halaman Profil Siswa.
    # Field lama tetap dipertahankan agar Dashboard Admin tidak terganggu.
    nama_lengkap = serializers.SerializerMethodField()
    role = serializers.SerializerMethodField()
    siswa_detail = serializers.SerializerMethodField()

    def _get_biodata(self, obj):
        return obj.biodata if isinstance(obj.biodata, dict) else {}

    def _get_rombel(self, obj):
        biodata = self._get_biodata(obj)
        rombel_id = biodata.get('rombel_id')

        if not rombel_id:
            return None

        try:
            from django.apps import apps
            Rombel = apps.get_model('registration_api', 'Rombel')

            return (
                Rombel.objects
                .select_related('tahun_ajaran', 'wali_tutor')
                .filter(pk=rombel_id)
                .first()
            )
        except Exception:
            return None

    def get_nama_lengkap(self, obj):
        biodata = self._get_biodata(obj)

        return (
            biodata.get('nama_lengkap')
            or biodata.get('nama')
            or obj.user.get_full_name()
            or obj.user.username
        )

    def get_role(self, obj):
        profile = getattr(obj.user, 'profile', None)
        return getattr(profile, 'role', 'siswa')

    def get_siswa_detail(self, obj):
        biodata = self._get_biodata(obj)
        dokumen = obj.dokumen if isinstance(obj.dokumen, dict) else {}
        rombel = self._get_rombel(obj)

        tahun_ajaran = ''
        wali_kelas = ''

        if rombel:
            tahun_obj = getattr(rombel, 'tahun_ajaran', None)

            if tahun_obj:
                nama_tahun = getattr(tahun_obj, 'nama', '') or ''
                semester = getattr(tahun_obj, 'semester', '') or ''

                tahun_ajaran = (
                    f'{nama_tahun} - {semester}'
                    if semester and semester.lower() not in nama_tahun.lower()
                    else nama_tahun
                )

            wali = getattr(rombel, 'wali_tutor', None)
            if wali:
                wali_kelas = (
                    getattr(wali, 'nama', '')
                    or str(wali)
                )

        return {
            'nis': (
                biodata.get('nis')
                or biodata.get('nomor_induk')
                or ''
            ),
            'nisn': biodata.get('nisn') or '',
            'nik': biodata.get('nik') or '',
            'nama_lengkap': (
                biodata.get('nama_lengkap')
                or biodata.get('nama')
                or obj.user.username
            ),
            'tempat_lahir': (
                biodata.get('tempat_lahir')
                or biodata.get('tempatLahir')
                or ''
            ),
            'tanggal_lahir': (
                biodata.get('tanggal_lahir')
                or biodata.get('tgl_lahir')
                or biodata.get('tglLahir')
                or ''
            ),
            'jenis_kelamin': (
                biodata.get('jenis_kelamin')
                or biodata.get('jk')
                or ''
            ),
            'agama': biodata.get('agama') or '',
            'alamat': (
                biodata.get('alamat_lengkap')
                or biodata.get('alamat')
                or ''
            ),
            'no_hp': biodata.get('no_hp') or '',
            'email': biodata.get('email') or obj.user.email or '',

            'nama_ayah': biodata.get('nama_ayah') or '',
            'pekerjaan_ayah': biodata.get('pekerjaan_ayah') or '',
            'nama_ibu': biodata.get('nama_ibu') or '',
            'pekerjaan_ibu': biodata.get('pekerjaan_ibu') or '',
            'nama_wali': biodata.get('nama_wali') or '',
            'hubungan_wali': biodata.get('hubungan_wali') or '',

            'program': obj.program_paket or '',
            'tipe_kelas': obj.tipe_kelas or '',
            'kelas': (
                getattr(rombel, 'nama_rombel', '')
                if rombel else ''
            ),
            'rombel_id': biodata.get('rombel_id') or '',
            'tahun_ajaran': tahun_ajaran,
            'wali_kelas': wali_kelas,

            'sekolah_asal': biodata.get('sekolah_asal') or '',
            'tahun_lulus': biodata.get('tahun_lulus') or '',
            'status_dalam_keluarga': (
                biodata.get('status_dalam_keluarga') or ''
            ),
            'anak_ke': biodata.get('anak_ke') or '',
            'tanggal_masuk': (
                biodata.get('tanggal_masuk_sekolah')
                or biodata.get('tanggal_masuk')
                or ''
            ),
            'status_dapodik': (
                biodata.get('status_dapodik')
                or 'BELUM_DIATUR'
            ),
            'status_sinkronisasi': {
                'BELUM_DIATUR': 'Belum Diatur',
                'BELUM_DIDAFTARKAN': 'Belum Didaftarkan',
                'PROSES_PENDATAAN': 'Proses Pendataan',
                'SUDAH_TERDAFTAR': 'Sudah Terdaftar',
                'DATA_BERMASALAH': 'Data Bermasalah',
            }.get(
                biodata.get('status_dapodik'),
                'Belum Diatur'
            ),
            'tanggal_terdaftar_dapodik': (
                biodata.get('tanggal_terdaftar_dapodik')
                or ''
            ),
            'catatan_dapodik': (
                biodata.get('catatan_dapodik')
                or ''
            ),

            'dokumen': dokumen,
        }

    class Meta:
        model = StudentRegistration
        fields = [
            'user_id',
            'id',
            'username',
            'email',
            'nama_lengkap',
            'role',
            'siswa_detail',
            'program_paket',
            'tipe_kelas',
            'registration_status',
            'biodata',
            'dokumen',
            'catatan_admin',
            'invoice',
            'rejection_logs',
            'created_at',
            'updated_at'
        ]


