                    'pilihan_jawaban':
                        'Pilihan ganda harus memiliki 4 opsi jawaban.'
                })

            if jawaban_benar not in ['A', 'B', 'C', 'D']:
                raise serializers.ValidationError({
                    'jawaban_benar':
                        'Jawaban benar harus A, B, C, atau D.'
                })

        if jenis_soal == 'ESAI':
            attrs['pilihan_jawaban'] = []

            if not str(jawaban_benar).strip():
                raise serializers.ValidationError({
                    'jawaban_benar':
                        'Panduan jawaban esai wajib diisi.'
                })

        return attrs

