import React, { useState } from 'react';
import { 
  ShieldCheck, 
  Clock, 
  FileText, 
  AlertTriangle, 
  Upload, 
  CheckCircle2, 
  ArrowLeft, 
  Info,
  LogOut,
  XCircle
} from 'lucide-react';
import { api } from '../lib/api';

interface RegistrationStatusPageProps {
  registration: any;
  onRefresh: () => void;
  onLogout: () => void;
}

export const RegistrationStatusPage: React.FC<RegistrationStatusPageProps> = ({ 
  registration, 
  onRefresh,
  onLogout
}) => {
  const [activeTab, setActiveTab] = useState<'status' | 'perbaikan'>('status');
  const [reUploadFiles, setReUploadFiles] = useState<{ [key: string]: string }>({});
  const [reUploadLogs, setReUploadLogs] = useState<string[]>([]);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [submitError, setSubmitError] = useState<string | null>(null);

  const [paymentProof, setPaymentProof] = useState<File | null>(null);
  const [paymentMethod, setPaymentMethod] = useState('TRANSFER_MANUAL');
  const [isSubmittingPayment, setIsSubmittingPayment] = useState(false);
  const [paymentError, setPaymentError] = useState<string | null>(null);

  const status = registration?.registration_status || 'MENUNGGU_VERIFIKASI';
  const notes = registration?.catatan_admin || '';
  const biodata = registration?.biodata || {};
  const dokumen = registration?.dokumen || {};
  const invoice = registration?.invoice || null;
  const paymentStatus = invoice?.payment_status || 'NONE';

  const handleSubmitPayment = async () => {
    if (!paymentProof || !registration?.id) {
      setPaymentError('Silakan pilih bukti pembayaran terlebih dahulu.');
      return;
    }

    try {
      setIsSubmittingPayment(true);
      setPaymentError(null);

      const formData = new FormData();
      formData.append('file', paymentProof);

      const uploadResponse = await fetch('/api/documents/upload', {
        method: 'POST',
        body: formData
      });

      const uploadResult = await uploadResponse.json();

      if (!uploadResponse.ok) {
        throw new Error(
          uploadResult.detail || 'Gagal mengunggah bukti pembayaran.'
        );
      }

      const fileUrl = uploadResult?.file?.url;

      if (!fileUrl) {
        throw new Error('URL bukti pembayaran tidak ditemukan.');
      }

      await api.uploadPublicPaymentProof(registration.id, {
        bukti_transfer: fileUrl,
        metode_pembayaran: paymentMethod
      });

      setPaymentProof(null);
      await onRefresh();

      alert(
        'Bukti pembayaran berhasil dikirim dan sedang menunggu verifikasi admin.'
      );
    } catch (err: any) {
      setPaymentError(
        err?.message || 'Gagal mengirim bukti pembayaran.'
      );
    } finally {
      setIsSubmittingPayment(false);
    }
  };

  // File type and size validator helper (3MB limit)
  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>, docType: string) => {
    const file = e.target.files?.[0];
    if (!file) return;

    // Check size (3MB = 3,145,728 bytes)
    const MAX_SIZE = 3 * 1024 * 1024;
    if (file.size > MAX_SIZE) {
      alert(`File ${file.name} melebihi batas ukuran 3MB!`);
      return;
    }

    // Check type
    const allowedExtensions = ['pdf', 'jpg', 'jpeg', 'png'];
    const extension = file.name.split('.').pop()?.toLowerCase();
    if (!extension || !allowedExtensions.includes(extension)) {
      alert(`Format file .${extension} tidak didukung! Gunakan format PDF, JPG, JPEG, atau PNG.`);
      return;
    }

    // Simulate renaming to UUID format securely
    const secureId = Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);
    const renamedFileName = `${docType}_${secureId}.${extension}`;

    // Convert file to Base64 mock URL for preview
    const reader = new FileReader();
    reader.onloadend = () => {
      setReUploadFiles(prev => ({
        ...prev,
        [docType]: reader.result as string
      }));
      setReUploadLogs(prev => [...prev, `Berhasil memuat file: ${renamedFileName} (${(file.size / 1024 / 1024).toFixed(2)} MB)`]);
    };
    reader.readAsDataURL(file);
  };

  const handleResubmit = async () => {
    setIsSubmitting(true);
    setSubmitError(null);
    try {
      // Update dokumen first
      const updatedDocs = { ...dokumen, ...reUploadFiles };
      await api.updateMyRegistration({ dokumen: updatedDocs });
      // Submit for re-verification
      await api.submitMyRegistration();
      onRefresh();
      alert("Berkas perbaikan berhasil dikirimkan ke Admin!");
      setActiveTab('status');
    } catch (err: any) {
      setSubmitError(err.message || "Gagal mengirimkan berkas perbaikan.");
    } finally {
      setIsSubmitting(false);
    }
  };

  const getStatusColor = () => {
    switch (status) {
      case 'DRAFT': return 'bg-slate-100 border-slate-200 text-slate-700';
      case 'MENUNGGU_VERIFIKASI': return 'bg-amber-50 border-amber-200 text-amber-700';
      case 'PERBAIKAN_DOKUMEN': return 'bg-pink-50 border-pink-200 text-pink-700';
      case 'KLARIFIKASI_DATA': return 'bg-orange-50 border-orange-200 text-orange-700';
      case 'DITERIMA': return 'bg-emerald-50 border-emerald-200 text-emerald-700';
      case 'DITOLAK_PERMANEN': return 'bg-rose-50 border-rose-200 text-rose-700';
      default: return 'bg-slate-100 border-slate-200 text-slate-700';
    }
  };

  const getStatusIcon = () => {
    switch (status) {
      case 'MENUNGGU_VERIFIKASI': return <Clock className="w-5 h-5 text-amber-500" />;
      case 'PERBAIKAN_DOKUMEN': return <AlertTriangle className="w-5 h-5 text-pink-500" />;
      case 'KLARIFIKASI_DATA': return <Info className="w-5 h-5 text-orange-500" />;
      case 'DITERIMA': return <CheckCircle2 className="w-5 h-5 text-emerald-500" />;
      case 'DITOLAK_PERMANEN': return <XCircle className="w-5 h-5 text-rose-500" />;
      default: return <Clock className="w-5 h-5 text-slate-500" />;
    }
  };

  const getStatusLabel = () => {
    switch (status) {
      case 'DRAFT': return 'Draft';
      case 'MENUNGGU_VERIFIKASI': return 'Menunggu Verifikasi Berkas';
      case 'PERBAIKAN_DOKUMEN': return 'Perbaikan Berkas / Dokumen';
      case 'KLARIFIKASI_DATA': return 'Perlu Klarifikasi Data';
      case 'DITERIMA': return 'Pendaftaran Diterima';
      case 'DITOLAK_PERMANEN': return 'Pendaftaran Ditolak Permanen';
      default: return status;
    }
  };

  // Timeline list mapping
  const timelineSteps = [
    { key: 'daftar', label: 'Registrasi Akun Berhasil', desc: 'Akun calon siswa berhasil dibuat di portal Lulus.id.', status: 'COMPLETED' },
    { 
      key: 'verifikasi', 
      label: 'Verifikasi Berkas Administrasi', 
      desc: status === 'MENUNGGU_VERIFIKASI' 
        ? 'Sedang ditinjau oleh staf tata usaha PKBM Agrabinta.' 
        : status === 'PERBAIKAN_DOKUMEN'
        ? 'Ditemukan ketidakcocokan berkas. Menunggu perbaikan dari Anda.'
        : status === 'KLARIFIKASI_DATA'
        ? 'Data Anda perlu diklarifikasi. Sila hubungi admin.'
        : status === 'DITOLAK_PERMANEN'
        ? 'Verifikasi gagal. Berkas ditolak permanen.'
        : 'Verifikasi berkas administrasi lolos & valid.', 
      status: status === 'MENUNGGU_VERIFIKASI' ? 'ACTIVE' : ['PERBAIKAN_DOKUMEN', 'KLARIFIKASI_DATA', 'DITOLAK_PERMANEN'].includes(status) ? 'WARNING' : 'COMPLETED' 
    },
    { 
      key: 'diterima', 
      label: 'Penerimaan Siswa Baru', 
      desc: status === 'DITERIMA' ? 'Selamat! Anda dinyatakan lulus seleksi administrasi Lulus.id.' : 'Menunggu tahap verifikasi selesai.', 
      status: status === 'DITERIMA' ? 'COMPLETED' : 'PENDING' 
    },
    { key: 'tagihan', label: 'Penerbitan Invoice Tagihan', desc: 'Tagihan biaya pendaftaran awal diterbitkan otomatis oleh sistem.', status: status === 'DITERIMA' ? 'ACTIVE' : 'PENDING' }
  ];

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans">
      {/* Top Banner Status */}
      <header className="bg-slate-900 border-b border-slate-800 px-6 py-4 flex items-center justify-between shrink-0">
        <div className="flex items-center gap-2.5">
          <div className="p-2 bg-pink-500/10 rounded-xl text-pink-500">
            <ShieldCheck className="w-5 h-5" />
          </div>
          <div>
            <h1 className="text-sm font-black tracking-tight text-slate-100">Portal Registrasi Lulus.id</h1>
            <p className="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Tahun Akademik 2026/2027</p>
          </div>
        </div>
        <div className="flex items-center gap-2">
          <button 
            onClick={onRefresh}
            className="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-[10px] font-bold text-slate-300 rounded-lg transition-all cursor-pointer"
          >
            Refresh Status
          </button>
          <button 
            onClick={onLogout}
            className="p-1.5 bg-rose-500/10 hover:bg-rose-500/20 rounded-lg text-rose-400 transition-all cursor-pointer"
            title="Keluar Akun"
          >
            <LogOut className="w-4 h-4" />
          </button>
        </div>
      </header>

      {/* Main Content Pane */}
      <main className="flex-1 max-w-4xl w-full mx-auto p-4 md:p-8 space-y-6">
        
        {/* Banner Alert Ringkasan */}
        <div className={`p-5 rounded-2xl border flex items-start gap-4 shadow-lg ${getStatusColor()}`}>
          <div className="p-2.5 bg-white/40 rounded-xl shrink-0">
            {getStatusIcon()}
          </div>
          <div className="space-y-1">
            <span className="text-[9px] font-black uppercase tracking-wider opacity-75">Status Pendaftaran Anda</span>
            <h2 className="text-sm font-black">{getStatusLabel()}</h2>
            <p className="text-[11px] font-semibold leading-relaxed">
              Halo, <strong className="underline">{biodata.nama || registration?.username}</strong>. 
              {status === 'MENUNGGU_VERIFIKASI' && " Berkas pendaftaran Anda telah kami terima secara lengkap dan aman di server kami. Staf verifikator kami akan melakukan peninjauan berkas selambat-lambatnya 1x24 jam."}
              {status === 'PERBAIKAN_DOKUMEN' && " Terdapat beberapa dokumen yang kurang jelas atau tidak sesuai. Sila lakukan perbaikan dan unggah ulang berkas pada tab 'Form Perbaikan Berkas' di bawah."}
              {status === 'KLARIFIKASI_DATA' && " Data yang Anda input memerlukan klarifikasi tatap muka atau telepon oleh panitia. Silakan hubungi WA Center PKBM Agrabinta di 0812-3456-7890."}
              {status === 'DITOLAK_PERMANEN' && " Mohon maaf, pendaftaran Anda ditolak secara permanen karena tidak memenuhi syarat kelayakan kesetaraan Lulus.id."}
            </p>
          </div>
        </div>

        {/* Admin Feedback Box */}
        {notes && (
          <div className="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-1.5 shadow-md">
            <h4 className="text-[10px] font-black text-rose-400 uppercase tracking-wider flex items-center gap-1">
              <AlertTriangle className="w-3.5 h-3.5" /> Catatan Dari Tim Verifikator:
            </h4>
            <p className="text-xs font-semibold text-slate-300 leading-relaxed bg-slate-950/60 p-3 rounded-xl border border-slate-800">
              "{notes}"
            </p>
          </div>
        )}

        {/* Tab Selection */}
        {['PERBAIKAN_DOKUMEN', 'KLARIFIKASI_DATA'].includes(status) && (
          <div className="flex bg-slate-900 p-1.5 rounded-xl border border-slate-800 shrink-0">
            <button
              onClick={() => setActiveTab('status')}
              className={`flex-1 py-2 text-center text-xs font-bold rounded-lg transition-all cursor-pointer ${activeTab === 'status' ? 'bg-slate-800 text-white shadow-xs' : 'text-slate-400 hover:text-slate-200'}`}
            >
              Timeline & Alur Verifikasi
            </button>
            <button
              onClick={() => setActiveTab('perbaikan')}
              className={`flex-1 py-2 text-center text-xs font-bold rounded-lg transition-all cursor-pointer ${activeTab === 'perbaikan' ? 'bg-rose-600 text-white shadow-xs' : 'text-slate-400 hover:text-slate-200'}`}
            >
              Form Perbaikan Berkas 🛠️
            </button>
          </div>
        )}

        {status === 'DITERIMA' && invoice && (
          <div className="bg-slate-900 border border-emerald-500/30 rounded-3xl p-6 shadow-xl space-y-5">
            <div className="flex items-start justify-between gap-4">
              <div>
                <p className="text-[9px] font-black uppercase tracking-widest text-emerald-400">
                  Tagihan Pendaftaran
                </p>
                <h3 className="text-xl font-black text-white mt-1">
                  Rp {Number(invoice.amount || 0).toLocaleString('id-ID')}
                </h3>
                <p className="text-[10px] text-slate-400 font-semibold mt-1">
                  Nomor invoice: {invoice.invoice_number}
                </p>
              </div>

              <span className="px-3 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-[9px] font-black uppercase">
                {paymentStatus === 'UNPAID'
                  ? 'Belum Dibayar'
                  : paymentStatus === 'WAITING_CONFIRMATION'
                  ? 'Menunggu Verifikasi'
                  : paymentStatus}
              </span>
            </div>

            {paymentStatus === 'UNPAID' && (
              <div className="space-y-4 border-t border-slate-800 pt-4">
                <div>
                  <label className="block text-[10px] font-black text-slate-300 uppercase mb-2">
                    Metode Pembayaran
                  </label>

                  <select
                    value={paymentMethod}
                    onChange={(e) => setPaymentMethod(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs text-slate-200"
                  >
                    <option value="TRANSFER_MANUAL">Transfer Bank</option>
                    <option value="QRIS">QRIS</option>
                    <option value="E_WALLET">E-Wallet</option>
                  </select>
                </div>

                <div>
                  <label className="block text-[10px] font-black text-slate-300 uppercase mb-2">
                    Bukti Pembayaran
                  </label>

                  <input
                    type="file"
                    accept=".jpg,.jpeg,.png,.pdf"
                    onChange={(e) =>
                      setPaymentProof(e.target.files?.[0] || null)
                    }
                    className="block w-full text-xs text-slate-400 bg-slate-950 border border-slate-800 rounded-xl p-3"
                  />

                  <p className="text-[9px] text-slate-500 mt-2">
                    Format PDF, JPG, JPEG, atau PNG. Maksimal 5 MB.
                  </p>
                </div>

                {paymentError && (
                  <div className="p-3 bg-rose-500/10 border border-rose-500/20 rounded-xl text-[10px] font-semibold text-rose-400">
                    {paymentError}
                  </div>
                )}

                <button
                  type="button"
                  onClick={handleSubmitPayment}
                  disabled={!paymentProof || isSubmittingPayment}
                  className="w-full py-3 bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-800 disabled:text-slate-500 rounded-xl text-xs font-black text-white"
                >
                  {isSubmittingPayment
                    ? 'Mengirim Bukti...'
                    : 'Kirim Bukti Pembayaran'}
                </button>
              </div>
            )}

            {paymentStatus === 'WAITING_CONFIRMATION' && (
              <div className="p-4 bg-amber-500/10 border border-amber-500/20 rounded-2xl">
                <p className="text-xs font-black text-amber-400">
                  Bukti pembayaran sudah diterima.
                </p>
                <p className="text-[10px] text-slate-400 mt-1">
                  Pembayaran sedang diperiksa oleh admin. Username dan password
                  belum dibuat sampai pembayaran disetujui dan plotting rombel selesai.
                </p>
              </div>
            )}
          </div>
        )}

        {/* View tab content */}
        {activeTab === 'status' || !['PERBAIKAN_DOKUMEN', 'KLARIFIKASI_DATA'].includes(status) ? (
          <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-6">
            <h3 className="text-xs font-extrabold text-slate-200 uppercase tracking-widest border-b border-slate-800 pb-2.5">
              Alur Progress Pendaftaran
            </h3>

            {/* Timeline component */}
            <div className="relative pl-6 border-l-2 border-slate-800 space-y-8 py-2">
              {timelineSteps.map((step, idx) => {
                const isCompleted = step.status === 'COMPLETED';
                const isActive = step.status === 'ACTIVE';
                const isWarning = step.status === 'WARNING';

                return (
                  <div key={idx} className="relative">
                    {/* Ring indicator */}
                    <span className={`absolute -left-[31px] top-1.5 w-4 h-4 rounded-full border-2 flex items-center justify-center ${
                      isCompleted 
                        ? 'bg-emerald-500 border-emerald-500 text-slate-950' 
                        : isActive 
                        ? 'bg-slate-950 border-amber-500 text-amber-500 animate-pulse' 
                        : isWarning
                        ? 'bg-pink-500 border-pink-500 text-slate-950'
                        : 'bg-slate-950 border-slate-800 text-slate-600'
                    }`}>
                      {isCompleted && <span className="w-1.5 h-1.5 rounded-full bg-slate-950"></span>}
                      {isActive && <span className="w-1.5 h-1.5 rounded-full bg-amber-500"></span>}
                      {isWarning && <span className="w-1.5 h-1.5 rounded-full bg-slate-950"></span>}
                    </span>

                    <div className="space-y-1">
                      <h4 className={`text-xs font-extrabold flex items-center gap-1.5 ${
                        isCompleted ? 'text-slate-200' : isActive ? 'text-amber-400' : isWarning ? 'text-pink-400 font-black' : 'text-slate-500'
                      }`}>
                        {step.label}
                        {isCompleted && <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />}
                      </h4>
                      <p className="text-[10.5px] text-slate-400 font-medium leading-relaxed">
                        {step.desc}
                      </p>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ) : (
          /* FORM PERBAIKAN BERKAS */
          <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-6">
            <div className="border-b border-slate-800 pb-3">
              <h3 className="text-xs font-black text-rose-400 uppercase tracking-widest">
                Formulir Unggah Ulang Berkas Bermasalah
              </h3>
              <p className="text-[10px] text-slate-400 font-bold mt-1">
                Silakan pilih berkas pengganti yang berukuran maksimal 3MB dan bertipe PDF atau Gambar (.jpg, .jpeg, .png).
              </p>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              
              {/* Pas Foto Upload */}
              <div className="p-4 bg-slate-950 border border-slate-800 rounded-2xl flex flex-col justify-between space-y-4">
                <div>
                  <h4 className="text-[11px] font-extrabold text-slate-200">1. Pas Foto Terbaru (3x4)</h4>
                  <p className="text-[9.5px] text-slate-500 font-semibold mt-0.5">Baju berkerah, latar merah/biru cerah.</p>
                </div>
                <div className="flex items-center gap-3">
                  <label className="flex items-center gap-1.5 px-3.5 py-2 bg-slate-800 hover:bg-slate-750 text-white rounded-xl text-[10px] font-black cursor-pointer transition-colors">
                    <Upload className="w-3.5 h-3.5" /> Pilih File
                    <input type="file" accept=".pdf,.jpg,.jpeg,.png" onChange={(e) => handleFileChange(e, 'foto')} className="hidden" />
                  </label>
                  <span className="text-[9.5px] font-bold text-slate-400 truncate max-w-[120px]">
                    {reUploadFiles.foto ? '✅ File Dimuat' : 'Belum diganti'}
                  </span>
                </div>
              </div>

              {/* Kartu Keluarga Upload */}
              <div className="p-4 bg-slate-950 border border-slate-800 rounded-2xl flex flex-col justify-between space-y-4">
                <div>
                  <h4 className="text-[11px] font-extrabold text-slate-200">2. Kartu Keluarga (KK)</h4>
                  <p className="text-[9.5px] text-slate-500 font-semibold mt-0.5">Seluruh lembar terlihat jelas, tidak terpotong.</p>
                </div>
                <div className="flex items-center gap-3">
                  <label className="flex items-center gap-1.5 px-3.5 py-2 bg-slate-800 hover:bg-slate-750 text-white rounded-xl text-[10px] font-black cursor-pointer transition-colors">
                    <Upload className="w-3.5 h-3.5" /> Pilih File
                    <input type="file" accept=".pdf,.jpg,.jpeg,.png" onChange={(e) => handleFileChange(e, 'kk')} className="hidden" />
                  </label>
                  <span className="text-[9.5px] font-bold text-slate-400 truncate max-w-[120px]">
                    {reUploadFiles.kk ? '✅ File Dimuat' : 'Belum diganti'}
                  </span>
                </div>
              </div>

              {/* KTP Upload */}
              <div className="p-4 bg-slate-950 border border-slate-800 rounded-2xl flex flex-col justify-between space-y-4">
                <div>
                  <h4 className="text-[11px] font-extrabold text-slate-200">3. KTP Calon Siswa / Ortu</h4>
                  <p className="text-[9.5px] text-slate-500 font-semibold mt-0.5">Pastikan tulisan NIK terbaca tajam.</p>
                </div>
                <div className="flex items-center gap-3">
                  <label className="flex items-center gap-1.5 px-3.5 py-2 bg-slate-800 hover:bg-slate-750 text-white rounded-xl text-[10px] font-black cursor-pointer transition-colors">
                    <Upload className="w-3.5 h-3.5" /> Pilih File
                    <input type="file" accept=".pdf,.jpg,.jpeg,.png" onChange={(e) => handleFileChange(e, 'ktp')} className="hidden" />
                  </label>
                  <span className="text-[9.5px] font-bold text-slate-400 truncate max-w-[120px]">
                    {reUploadFiles.ktp ? '✅ File Dimuat' : 'Belum diganti'}
                  </span>
                </div>
              </div>

              {/* Ijazah Upload */}
              <div className="p-4 bg-slate-950 border border-slate-800 rounded-2xl flex flex-col justify-between space-y-4">
                <div>
                  <h4 className="text-[11px] font-extrabold text-slate-200">4. Ijazah Terakhir</h4>
                  <p className="text-[9.5px] text-slate-500 font-semibold mt-0.5">Ijazah SMP/Mts untuk Paket C, SD untuk Paket B.</p>
                </div>
                <div className="flex items-center gap-3">
                  <label className="flex items-center gap-1.5 px-3.5 py-2 bg-slate-800 hover:bg-slate-750 text-white rounded-xl text-[10px] font-black cursor-pointer transition-colors">
                    <Upload className="w-3.5 h-3.5" /> Pilih File
                    <input type="file" accept=".pdf,.jpg,.jpeg,.png" onChange={(e) => handleFileChange(e, 'ijazah')} className="hidden" />
                  </label>
                  <span className="text-[9.5px] font-bold text-slate-400 truncate max-w-[120px]">
                    {reUploadFiles.ijazah ? '✅ File Dimuat' : 'Belum diganti'}
                  </span>
                </div>
              </div>

            </div>

            {/* Audit Logs */}
            {reUploadLogs.length > 0 && (
              <div className="p-3 bg-slate-950 border border-slate-800 rounded-xl space-y-1">
                <span className="text-[8px] font-black text-slate-500 uppercase tracking-widest">Audit Unggah File Secure:</span>
                <div className="max-h-24 overflow-y-auto space-y-0.5 font-mono text-[9px] text-emerald-400">
                  {reUploadLogs.map((log, lidx) => (
                    <div key={lidx}>- {log}</div>
                  ))}
                </div>
              </div>
            )}

            {submitError && (
              <div className="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-xl text-[11px] font-semibold">
                ⚠️ {submitError}
              </div>
            )}

            {/* Action Submit */}
            <div className="flex gap-3 border-t border-slate-800 pt-4">
              <button
                type="button"
                onClick={() => setActiveTab('status')}
                className="flex-1 py-3 bg-slate-800 hover:bg-slate-750 text-slate-300 rounded-xl text-xs font-bold transition-all cursor-pointer"
              >
                Kembali ke Alur
              </button>
              <button
                type="button"
                onClick={handleResubmit}
                disabled={isSubmitting || Object.keys(reUploadFiles).length === 0}
                className="flex-1 py-3 bg-rose-600 hover:bg-rose-700 disabled:bg-slate-800 disabled:text-slate-500 text-white rounded-xl text-xs font-black shadow-lg shadow-rose-600/15 transition-all cursor-pointer disabled:cursor-not-allowed"
              >
                {isSubmitting ? 'Mengirim Berkas...' : 'Kirim Perbaikan Berkas 🚀'}
              </button>
            </div>
          </div>
        )}
      </main>
    </div>
  );
};
