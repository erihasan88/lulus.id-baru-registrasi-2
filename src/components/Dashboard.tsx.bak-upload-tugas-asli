  const handleAnalyzeSkkWithAi = async (studentObj: any, myComps: any[], mySubmissions: any[]) => {
    setAiSkkLoading(true);
    setAiSkkRecommendation('');
    
    const achievedComps = myComps.filter(c => mySubmissions.some(sc => sc.kompetensi === c.id && sc.status === 'tercapai'));
    const processComps = myComps.filter(c => mySubmissions.some(sc => sc.kompetensi === c.id && sc.status === 'proses'));
    const pendingComps = myComps.filter(c => !mySubmissions.some(sc => sc.kompetensi === c.id));

    const totalPoints = myComps.reduce((sum, c) => sum + c.bobot_skk, 0);
    const achievedPoints = achievedComps.reduce((sum, c) => sum + c.bobot_skk, 0);
    const processPoints = processComps.reduce((sum, c) => sum + c.bobot_skk, 0);

    const prompt = `Lakukan analisis Satuan Kredit Kompetensi (SKK) untuk siswa berikut:
Nama: ${studentObj.nama}
Program: ${studentObj.program}
Capaian SKK: ${achievedPoints} dari total ${totalPoints} SKK tercapai (${totalPoints > 0 ? Math.round(achievedPoints / totalPoints * 100) : 0}%).
SKK dalam proses verifikasi: ${processPoints} SKK.

RINCIAN KOMPETENSI SAYA:
1. Kompetensi Sudah Tercapai:
${achievedComps.map(c => `- [${c.mata_pelajaran}] ${c.nama_kompetensi} (${c.bobot_skk} SKK)`).join('\n') || 'Belum ada'}

2. Kompetensi Sedang Dalam Proses Peninjauan Guru:
${processComps.map(c => `- [${c.mata_pelajaran}] ${c.nama_kompetensi} (${c.bobot_skk} SKK)`).join('\n') || 'Belum ada'}

3. Kompetensi Belum Mulai / Belum Tercapai:
${pendingComps.map(c => `- [${c.mata_pelajaran}] ${c.nama_kompetensi} (${c.bobot_skk} SKK)`).join('\n') || 'Belum ada'}

Tolong berikan laporan analisis perkembangan kompetensi siswa ini beserta rencana aksi (Action Plan) konkret, taktis, dan menyemangati siswa non-formal agar segera mencapai sisa kompetensinya secara menyenangkan. Format respons dengan markdown yang sangat rapi dan ramah anak. Batasi maksimal 4 paragraf/bagian singkat.`;

    try {
      const response = await fetch('/api/gemini', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          prompt,
          systemInstruction: 'Kamu adalah Lulus AI Ahli Kurikulum SKK. Tugasmu menganalisis pencapaian kompetensi siswa dan memberikan strategi belajar mandiri yang efisien dan memotivasi siswa PKBM.'
        })
      });

      if (!response.ok) throw new Error('Gagal menghubungi AI.');
      const data = await response.json();
      setAiSkkRecommendation(data.text);
    } catch (err: any) {
      setAiSkkRecommendation(`Terjadi kendala saat menganalisis progres SKK: ${err.message}. Silakan coba beberapa saat lagi.`);
    } finally {
      setAiSkkLoading(false);
    }
  };

