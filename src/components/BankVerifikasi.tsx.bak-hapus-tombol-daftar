                  <Search className="w-3 h-3 text-slate-400 absolute left-2.5 top-2.5" />
                  <input
                    type="text"
                    placeholder="Cari Kode QR / Nama Siswa / No Dokumen..."
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
