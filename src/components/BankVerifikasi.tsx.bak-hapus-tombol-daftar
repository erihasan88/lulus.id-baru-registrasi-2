                  <div className="text-[9.5px] text-slate-400 font-semibold max-w-xs leading-normal">
                    Cobalah mengubah parameter pencarian atau saring jenis dokumen yang dicari.
                  </div>
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full text-left border-collapse">
                    <thead>
                      <tr className="bg-slate-50 border-b border-slate-200 text-slate-500 text-[8.5px] font-black uppercase tracking-wider">
                        <th className="px-4 py-2.5 text-center w-12">QR Code</th>
                        <th className="px-4 py-2.5">Kode Verifikasi</th>
                        <th className="px-4 py-2.5">Jenis Dokumen</th>
                        <th className="px-4 py-2.5">Identitas Penerima (Siswa)</th>
                        <th className="px-4 py-2.5">Tanggal Terbit</th>
                        <th className="px-4 py-2.5">Pejabat Pengesahan</th>
                        <th className="px-4 py-2.5 text-center">Status Validasi</th>
                        <th className="px-4 py-2.5 text-right">Aksi</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-100 text-[9.5px] font-semibold text-slate-600">
                      {filteredDocs.map((doc) => {
                        const hasSnapshot = !!doc.snapshotData;
                        return (
                          <tr key={doc.id} className="hover:bg-slate-50/40 transition-colors">
                            
                            {/* QR Thumbnail */}
                            <td className="px-4 py-2 text-center">
                              <button 
                                onClick={() => handleOpenQR(doc.verificationCode)}
                                className="hover:scale-105 transition-transform inline-block cursor-pointer focus:outline-none"
                                title="Perbesar QR Code"
                              >
                                <DocumentQRCodeMini code={doc.verificationCode} size={36} />
                              </button>
                            </td>

                            {/* Verification Code */}
                            <td className="px-4 py-2">
                              <span className="font-black text-slate-800 font-mono text-[10px] block">
                                {doc.verificationCode}
                              </span>
                              <code className="text-[8px] text-slate-400 block font-mono">
                                No: {doc.snapshotData?.documentNumber || doc.id.substring(0, 12)}
                              </code>
                            </td>

                            {/* Document Type */}
                            <td className="px-4 py-2">
                              <span className={`px-2 py-0.5 rounded text-[8px] font-black uppercase inline-block border ${
                                doc.documentType === 'E-Rapor' ? 'bg-indigo-50 text-indigo-700 border-indigo-100' :
                                doc.documentType === 'Formulir PPDB' ? 'bg-pink-50 text-pink-700 border-pink-100' :
                                doc.documentType === 'Ijazah' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' :
                                doc.documentType === 'SKL' ? 'bg-blue-50 text-blue-700 border-blue-100' :
                                'bg-slate-100 text-slate-700 border-slate-200'
                              }`}>
                                {doc.documentType}
                              </span>
                            </td>

                            {/* Student Profile */}
                            <td className="px-4 py-2">
                              <span className="font-black text-slate-900 block">{doc.studentName}</span>
                              <span className="text-[8px] text-slate-400 block font-bold leading-normal">
                                NISN: {doc.studentNisn || '-'} • {doc.studentProgram || '-'} ({doc.studentKelas || 'Umum'})
                              </span>
                            </td>

                            {/* Issue Date */}
                            <td className="px-4 py-2 text-slate-500 font-mono text-[9px]">
                              {doc.issueDate}
                            </td>

                            {/* Authorized Signer */}
                            <td className="px-4 py-2">
                              <span className="text-slate-700 block font-bold">{doc.signerName}</span>
                              <span className="text-[8px] text-slate-400 block font-semibold leading-none">{doc.signerRole}</span>
                            </td>

                            {/* Validation Status */}
                            <td className="px-4 py-2 text-center">
                              <span className={`px-2 py-0.5 rounded-full text-[8px] font-black uppercase inline-flex items-center gap-1 border ${
                                doc.isValid 
                                  ? 'bg-emerald-50 text-emerald-600 border-emerald-150'
                                  : 'bg-rose-50 text-rose-600 border-rose-150'
                              }`}>
                                {doc.isValid ? (
                                  <>
                                    <span className="w-1 h-1 rounded-full bg-emerald-500"></span>
                                    Valid & Aktif
                                  </>
                                ) : (
                                  <>
                                    <span className="w-1 h-1 rounded-full bg-rose-500"></span>
                                    Dicabut
                                  </>
                                )}
                              </span>
                              {doc.notes && (
                                <span className="block text-[7px] text-amber-600 font-bold truncate max-w-[120px] mx-auto mt-0.5" title={doc.notes}>
                                  "{doc.notes}"
                                </span>
                              )}
                            </td>

                            {/* Actions Column */}
                            <td className="px-4 py-2 text-right">
                              <div className="flex items-center justify-end gap-1.5">
                                <button
                                  onClick={() => {
                                    setSelectedDoc(doc);
                                    setShowDetailModal(true);
                                  }}
                                  className="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[8.5px] font-black cursor-pointer transition-all flex items-center gap-0.5 border border-slate-200"
                                  title="Buka Snapshot Data"
                                >
                                  <Eye className="w-2.5 h-2.5" /> Snapshot
                                </button>

                                {role === 'admin' && (
                                  <>
                                    <button
                                      onClick={() => handleToggleValidation(doc)}
                                      className={`px-2 py-0.5 rounded text-[8.5px] font-black transition-all cursor-pointer flex items-center gap-0.5 ${
                                        doc.isValid
                                          ? 'bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200'
                                          : 'bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200'
                                      }`}
                                      title={doc.isValid ? "Mencabut Validasi" : "Pulihkan Validasi"}
                                    >
                                      {doc.isValid ? (
                                        <>
                                          <X className="w-2.5 h-2.5" /> Cabut
                                        </>
                                      ) : (
                                        <>
                                          <Check className="w-2.5 h-2.5" /> Sahkan
                                        </>
                                      )}
                                    </button>

                                    <button
                                      onClick={() => handleDeleteRecord(doc)}
                                      className="p-1 text-slate-400 hover:text-red-500 hover:bg-red-50 border border-slate-100 hover:border-red-100 rounded transition-all cursor-pointer"
                                      title="Hapus Arsip Permanent"
                                    >
                                      <Trash2 className="w-3 h-3" />
                                    </button>
                                  </>
                                )}
                              </div>
                            </td>

                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}
            </div>

          </div>
        )}

        {/* VIEW: REGISTER NEW CUSTOM DOCUMENT FORM */}

      </div>

      {/* --- MODAL 1: VIEW DETAIL SNAPSHOT DATA --- */}
      {showDetailModal && selectedDoc && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs select-none">
          <div className="bg-white rounded-3xl border border-slate-200 shadow-2xl w-full max-w-xl max-h-[85vh] flex flex-col overflow-hidden animate-fade-in text-slate-800">
            
            {/* Header */}
            <div className="p-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
              <div className="flex items-center gap-2">
                <FileText className="w-4 h-4 text-emerald-600" />
                <div>
                  <h4 className="text-xs font-black text-slate-900">Snapshot & Metadata Dokumen Resmi</h4>
                  <code className="text-[8px] text-slate-400 font-mono">Kode QR: {selectedDoc.verificationCode}</code>
                </div>
              </div>
              <button 
                onClick={() => {
                  setSelectedDoc(null);
                  setShowDetailModal(false);
                }}
                className="p-1 hover:bg-slate-200 text-slate-400 hover:text-slate-600 rounded-lg transition-colors cursor-pointer"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Body */}
            <div className="p-5 overflow-y-auto space-y-4 text-left">
              
              {/* Document Status banner */}
              <div className={`p-4 rounded-2xl border flex items-center gap-3 ${
                selectedDoc.isValid 
                  ? 'bg-emerald-50 border-emerald-100 text-emerald-800' 
                  : 'bg-rose-50 border-rose-100 text-rose-800'
              }`}>
                {selectedDoc.isValid ? (
                  <>
                    <ShieldCheck className="w-6 h-6 text-emerald-600 shrink-0" />
                    <div>
                      <span className="font-extrabold uppercase tracking-wide block text-[10px]">Dokumen Sah & Terverifikasi Aktif</span>
                      <p className="text-[8.5px] text-emerald-600 font-medium leading-normal mt-0.5">
                        Dokumen ini dinyatakan sah dan aktif di dalam pangkalan data verifikasi digital Lulus.id.
                      </p>
                    </div>
                  </>
                ) : (
                  <>
                    <ShieldAlert className="w-6 h-6 text-rose-600 shrink-0" />
                    <div>
                      <span className="font-extrabold uppercase tracking-wide block text-[10px]">Dokumen Ditangguhkan / Dicabut</span>
                      <p className="text-[8.5px] text-rose-600 font-medium leading-normal mt-0.5">
                        Otorisasi verifikasi dokumen ini ditarik sementara oleh administrator.
                      </p>
                    </div>
                  </>
                )}
              </div>

              {/* Bento details grid */}
              <div className="bg-slate-50/70 border border-slate-150 rounded-2xl p-4 space-y-3">
                <h5 className="text-[9px] font-black text-slate-400 uppercase tracking-wider border-b border-slate-200 pb-1.5">Identitas Arsip Resmi</h5>
                
                <div className="grid grid-cols-3 gap-y-2 text-xs font-semibold text-slate-600">
                  <span className="text-[8.5px] font-extrabold text-slate-400">Jenis Dokumen</span>
                  <span className="col-span-2 text-slate-800 font-black uppercase text-[9px]">{selectedDoc.documentType}</span>

                  <span className="text-[8.5px] font-extrabold text-slate-400">Nama Penerima</span>
                  <span className="col-span-2 text-slate-950 font-black">{selectedDoc.studentName}</span>

                  <span className="text-[8.5px] font-extrabold text-slate-400">NISN Siswa</span>
                  <span className="col-span-2 font-mono text-slate-800">{selectedDoc.studentNisn || '-'}</span>

                  <span className="text-[8.5px] font-extrabold text-slate-400">Program / Kelas</span>
                  <span className="col-span-2 text-slate-700">{selectedDoc.studentProgram || '-'} ({selectedDoc.studentKelas || 'Umum'})</span>

                  <span className="text-[8.5px] font-extrabold text-slate-400">Nomor Dokumen</span>
                  <span className="col-span-2 font-mono text-slate-800">{selectedDoc.snapshotData?.documentNumber || '-'}</span>

                  <span className="text-[8.5px] font-extrabold text-slate-400">Tanggal Terbit</span>
                  <span className="col-span-2 text-slate-700">{selectedDoc.issueDate}</span>

                  <span className="text-[8.5px] font-extrabold text-slate-400">Pejabat Pengesah</span>
                  <span className="col-span-2 text-slate-800 font-bold">{selectedDoc.signerName} ({selectedDoc.signerRole})</span>
                </div>
              </div>

              {/* Snapshot data view based on type */}
              <div className="space-y-2">
                <h5 className="text-[9px] font-black text-slate-400 uppercase tracking-wider">Snapshot Isi Dokumen</h5>
                
                {selectedDoc.documentType === 'E-Rapor' && selectedDoc.snapshotData?.subjects ? (
                  <div className="border border-slate-200 rounded-2xl p-3.5 space-y-2 bg-white">
                    <span className="text-[8px] font-black text-indigo-600 uppercase tracking-wide block">Rincian Hasil Belajar Semester</span>
                    <div className="divide-y divide-slate-100 overflow-hidden">
                      {selectedDoc.snapshotData.subjects.map((sub: any) => (
                        <div key={sub.id} className="py-1.5 flex items-center justify-between text-[10px]">
                          <span className="font-extrabold text-slate-700">{sub.name}</span>
                          <div className="flex items-center gap-3">
                            <span className="text-[8.5px] font-semibold text-slate-400">SKK: {sub.bobotSkk}</span>
                            <span className="font-black text-slate-900 bg-slate-50 px-2 py-0.5 border border-slate-100 rounded">{sub.grade}</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : selectedDoc.documentType === 'Formulir PPDB' ? (
                  <div className="border border-slate-200 rounded-2xl p-4 space-y-3 bg-white text-[9.5px]">
                    <span className="text-[8px] font-black text-pink-600 uppercase tracking-wide block">Rincian Berkas Pendaftaran Siswa</span>
                    
                    <div className="grid grid-cols-2 gap-x-4 gap-y-2 text-slate-600 font-semibold">
                      <div>
                        <span className="text-[8px] text-slate-400 uppercase block">NIK</span>
                        <span className="text-slate-800 font-bold">{selectedDoc.snapshotData?.nik || '-'}</span>
                      </div>
                      <div>
                        <span className="text-[8px] text-slate-400 uppercase block">No. KK</span>
                        <span className="text-slate-800 font-bold">{selectedDoc.snapshotData?.kk || '-'}</span>
                      </div>
                      <div>
                        <span className="text-[8px] text-slate-400 uppercase block">Nama Ibu Kandung</span>
                        <span className="text-slate-800 font-bold">{selectedDoc.snapshotData?.ibu || '-'}</span>
                      </div>
                      <div>
                        <span className="text-[8px] text-slate-400 uppercase block">Nama Ayah</span>
                        <span className="text-slate-800 font-bold">{selectedDoc.snapshotData?.ayah || '-'}</span>
                      </div>
                      <div className="col-span-2 border-t border-slate-100 pt-2 mt-1">
                        <span className="text-[8px] text-slate-400 uppercase block">Alamat Domisili</span>
                        <span className="text-slate-800">{selectedDoc.snapshotData?.alamat || '-'}</span>
                      </div>
                    </div>
                  </div>
                ) : (
                  <div className="border border-slate-200 rounded-2xl p-4 bg-slate-900 text-emerald-400 font-mono text-[9px] whitespace-pre-wrap overflow-x-auto">
                    {JSON.stringify(selectedDoc.snapshotData, null, 2)}
                  </div>
                )}
              </div>

              {/* Verifier Notes text */}
              {selectedDoc.notes && (
                <div className="p-3 bg-amber-50 border border-amber-200 rounded-xl">
                  <span className="text-[8px] font-black text-amber-800 uppercase tracking-wide block">Catatan Verifikator Utama</span>
                  <p className="text-[9px] text-amber-900 mt-1 font-medium leading-relaxed italic">
                    "{selectedDoc.notes}"
                  </p>
                </div>
              )}

            </div>

            {/* Footer */}
            <div className="p-3.5 bg-slate-50 border-t border-slate-200 flex justify-between items-center shrink-0">
              <span className="text-[7.5px] font-bold text-slate-400">DIKUNCI OLEH SERVER Django ORM</span>
              <button
                onClick={() => {
                  setSelectedDoc(null);
                  setShowDetailModal(false);
                }}
                className="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-[9.5px] font-black uppercase tracking-wider cursor-pointer"
              >
                Tutup
              </button>
            </div>

          </div>
        </div>
      )}

      {/* --- MODAL 2: EXPANDED QR CODE FOR CAMERA SCANNING --- */}
      {showQRModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/65 backdrop-blur-xs select-none">
          <div className="bg-white rounded-3xl border border-slate-200 shadow-2xl p-6 text-center w-full max-w-sm flex flex-col items-center animate-fade-in text-slate-800">
            
            <div className="flex justify-between items-center w-full border-b border-slate-100 pb-3 mb-4">
              <span className="text-[9px] font-black text-slate-400 uppercase tracking-widest">Sertifikasi QR Code</span>
              <button 
                onClick={() => setShowQRModal(false)}
                className="p-1 hover:bg-slate-100 text-slate-400 hover:text-slate-600 rounded-lg cursor-pointer"
              >
                <X className="w-4.5 h-4.5" />
              </button>
            </div>

            <div className="w-64 h-64 bg-slate-50 border border-slate-100 rounded-3xl p-4 flex items-center justify-center shadow-inner relative">
              <img src={largeQRCodeSrc} alt="Verified QR Code" className="w-full h-full object-contain" />
              <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
                <div className="p-1 bg-white rounded-lg border border-slate-200/80 shadow">
                  <ShieldCheck className="w-6 h-6 text-emerald-600" />
                </div>
              </div>
            </div>

            <div className="mt-4 space-y-1">
              <h4 className="text-xs font-black text-slate-900 uppercase">Pindai Dengan Kamera HP</h4>
              <p className="text-[10px] text-slate-400 font-semibold max-w-xs leading-relaxed">
                Arahkan lensa kamera handphone Anda ke QR Code di atas untuk membuka portal verifikasi dokumen resmi Lulus.id PKBM Agrabinta.
              </p>
            </div>

            <button
              onClick={() => setShowQRModal(false)}
              className="mt-5 w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-[10px] font-black uppercase tracking-wider cursor-pointer"
            >
              Selesai Memindai
            </button>

          </div>
        </div>
      )}

    </div>
  );
}
