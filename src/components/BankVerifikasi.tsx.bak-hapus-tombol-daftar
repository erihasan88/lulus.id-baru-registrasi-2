import React, { useState, useEffect } from 'react';
import { 
  QrCode, Search, Filter, ShieldCheck, ShieldAlert, Award, FileText, 
  Calendar, User, CheckCircle2, XCircle, Plus, Eye, Check, X, 
  Download, Trash2, Edit, AlertCircle, RefreshCw, FileSpreadsheet,
  Layers, Building2, BadgeCheck, HelpCircle, FileCheck2
} from 'lucide-react';
import QRCode from 'qrcode';
import { VerificationDocument, Student, Role } from '../types';
import { api } from '../lib/api';

interface BankVerifikasiProps {
  role: Role;
  students: Student[];
  loggedInUser: {
    id: string;
    nama: string;
    role: Role;
  };
  showModal: (title: string, desc: string, type?: 'info' | 'warning' | 'success') => void;
}

function DocumentQRCodeMini({ code, size = 42 }: { code: string; size?: number }) {
  const [qrSrc, setQrSrc] = useState<string>('');

  useEffect(() => {
    const origin = typeof window !== 'undefined' ? window.location.origin : 'https://lulus.id';
    const url = `${origin}/verifikasi/${code}`;
    QRCode.toDataURL(url, {
      margin: 1,
      width: size * 2,
      errorCorrectionLevel: 'H',
      color: {
        dark: '#0f172a',
        light: '#ffffff'
      }
    })
      .then(src => setQrSrc(src))
      .catch(err => console.error('Failed to generate document QR Code', err));
  }, [code, size]);

  return (
    <div className="relative p-0.5 bg-white rounded border border-slate-200 shadow-3xs flex items-center justify-center shrink-0" style={{ width: size, height: size }}>
      {qrSrc ? (
        <img 
          src={qrSrc} 
          alt="QR" 
          className="w-full h-full object-contain"
        />
      ) : (
        <div className="w-full h-full bg-slate-100 animate-pulse rounded" />
      )}
    </div>
  );
}

export default function BankVerifikasi({ role, students, loggedInUser, showModal }: BankVerifikasiProps) {
  // --- STATE FOR INSTITUTION ---
  const [lembagaIdentitas] = useState(() => {
    const saved = localStorage.getItem('lulus_lembaga_identitas');
    if (saved) {
      try { return JSON.parse(saved); } catch (e) { }
    }
    return {
      namaPkbm: 'PKBM Agrabinta Lulus.id',
      namaYayasan: 'Yayasan Pendidikan Agrabinta Sukabumi',
      npsn: 'P9961234',
      namaKepalaSekolah: 'Drs. H. Mulyadi, M.Pd.',
      tandaTanganKepalaSekolah: 'https://placehold.co/200x100/ffffff/000000?text=Tanda+Tangan',
      namaPejabatTtd: 'Drs. H. Mulyadi, M.Pd.',
      jabatanPejabatTtd: 'Kepala PKBM'
    };
  });

  // --- STATE PERSISTENCE ---
  const [verifiedDocs, setVerifiedDocs] = useState<VerificationDocument[]>([]);
  const [viewState, setViewState] = useState<'list' | 'add'>('list');
  
  // Filtering & Searching
  const [searchQuery, setSearchQuery] = useState('');
  const [filterType, setFilterType] = useState('all');
  const [filterStatus, setFilterStatus] = useState('all'); // all, valid, invalid
  const [filterYear, setFilterYear] = useState('all');

  // Detail Modal
  const [selectedDoc, setSelectedDoc] = useState<VerificationDocument | null>(null);
  const [showDetailModal, setShowDetailModal] = useState(false);
  const [showQRModal, setShowQRModal] = useState(false);
  const [largeQRCodeSrc, setLargeQRCodeSrc] = useState('');

  // Form States for Registering New Document
  const [formStudentId, setFormStudentId] = useState('');
  const [formStudentName, setFormStudentName] = useState('');
  const [formNisn, setFormNisn] = useState('');
  const [formProgram, setFormProgram] = useState('Paket C');
  const [formKelas, setFormKelas] = useState('');
  const [formDocType, setFormDocType] = useState('Sertifikat');
  const [formDocNumber, setFormDocNumber] = useState('');
  const [formIssueDate, setFormIssueDate] = useState(new Date().toISOString().split('T')[0]);
  const [formSignerName, setFormSignerName] = useState(lembagaIdentitas.namaPejabatTtd || lembagaIdentitas.namaKepalaSekolah);
  const [formSignerRole, setFormSignerRole] = useState(lembagaIdentitas.jabatanPejabatTtd || 'Kepala PKBM');
  const [formNotes, setFormNotes] = useState('');
  const [formCustomDataJson, setFormCustomDataJson] = useState('{\n  "kategori": "Uji Kompetensi",\n  "predikat": "Sangat Baik",\n  "penyelenggara": "PKBM Agrabinta"\n}');

  // Load documents from backend
  const loadConsolidatedDocuments = async () => {
    try {
      const [documents, transcripts] = await Promise.all([
        api.getAcademicDocuments(),
        api.getAcademicTranscripts()
      ]);

      const academicDocs: VerificationDocument[] = (documents || []).map((doc: any) => ({
        id: String(doc.id),
        verificationCode: doc.verification_code,
        documentType:
          doc.document_type === 'IJAZAH'
            ? 'Ijazah'
            : doc.document_type === 'SKL'
              ? 'SKL'
              : doc.document_type === 'TRANSKRIP'
                ? 'Transkrip Nilai'
                : 'Sertifikat',
        studentId: String(doc.student),
        studentName: doc.student_name || doc.student_username || 'Siswa',
        studentNisn: doc.student_username || '-',
        studentProgram: '',
        studentKelas: '',
        issueDate: doc.issue_date || doc.created_at?.split('T')[0] || '',
        signerName:
          lembagaIdentitas.namaPejabatTtd ||
          lembagaIdentitas.namaKepalaSekolah,
        signerRole:
          lembagaIdentitas.jabatanPejabatTtd ||
          'Kepala PKBM',
        isValid: doc.status === 'PUBLISHED',
        snapshotData: {
          documentNumber: doc.document_number,
          title: doc.title,
          fileUrl: doc.file_url,
          status: doc.status,
          graduationYear: doc.graduation_year,
          downloads: doc.downloads_count,
          views: doc.views_count
        },
        createdAt: doc.created_at,
        notes: doc.verification_notes || ''
      }));

      const transcriptDocs: VerificationDocument[] = (transcripts || []).map((doc: any) => ({
        id: `TRANSCRIPT-${doc.id}`,
        verificationCode: doc.verification_code,
        documentType: 'Transkrip Nilai',
        studentId: String(doc.student),
        studentName: doc.student_name || doc.student_username || 'Siswa',
        studentNisn: doc.student_username || '-',
        studentProgram: '',
        studentKelas: '',
        issueDate: doc.issue_date || doc.created_at?.split('T')[0] || '',
        signerName:
          lembagaIdentitas.namaPejabatTtd ||
          lembagaIdentitas.namaKepalaSekolah,
        signerRole:
          lembagaIdentitas.jabatanPejabatTtd ||
          'Kepala PKBM',
        isValid: doc.status === 'PUBLISHED',
        snapshotData: {
          documentNumber: doc.document_number,
          academicYear: doc.academic_year,
          semester: doc.semester,
          subjects: doc.subjects,
          averageScore: doc.average_score,
          predicate: doc.predicate,
          status: doc.status
        },
        createdAt: doc.created_at,
        notes: ''
      }));

      const combined = [...academicDocs, ...transcriptDocs].sort(
        (a, b) => (b.issueDate || '').localeCompare(a.issueDate || '')
      );

      setVerifiedDocs(combined);
    } catch (err) {
      console.error('Gagal memuat Bank Verifikasi:', err);
      showModal(
        'Gagal Memuat Data',
        'Bank Verifikasi belum berhasil mengambil dokumen dari server.',
        'warning'
      );
    }
  };

  useEffect(() => {
    loadConsolidatedDocuments();
  }, []);

  // --- ACTIONS ---

  // Generate Large QR Code for view
  const handleOpenQR = (code: string) => {
    const origin = typeof window !== 'undefined' ? window.location.origin : 'https://lulus.id';
    const url = `${origin}/verifikasi/${code}`;
    QRCode.toDataURL(url, {
      margin: 2,
      width: 320,
      errorCorrectionLevel: 'H',
      color: {
        dark: '#0f172a',
        light: '#ffffff'
      }
    })
      .then(src => {
        setLargeQRCodeSrc(src);
        setShowQRModal(true);
      })
      .catch(err => console.error(err));
  };

  // Toggle validation status (isValid = true/false)
  const handleToggleValidation = (doc: VerificationDocument) => {
    if (role !== 'admin') {
      showModal('Akses Ditolak', 'Hanya Administrator yang memiliki wewenang untuk mencabut atau memulihkan validasi dokumen resmi.', 'warning');
      return;
    }

    const currentStatus = doc.isValid;
    const actionWord = currentStatus ? 'Mencabut' : 'Mengaktifkan';
    const promptNotes = window.prompt(`Apakah Anda yakin ingin ${actionWord.toLowerCase()} status validasi dokumen dengan kode "${doc.verificationCode}"?\n\nMasukkan alasan atau catatan verifikator:`, doc.notes || '');
    
    if (promptNotes === null) return; // User cancelled

    const newIsValid = !currentStatus;

    // Apply change back to the correct storage location
    if (doc.documentType === 'Formulir PPDB') {
      // Update student list status (lulus_students)
      const savedStudents = localStorage.getItem('lulus_students');
      if (savedStudents) {
        try {
          const studentList: Student[] = JSON.parse(savedStudents);
          const updated = studentList.map(s => {
            if (s.id === doc.studentId) {
              const timestamp = new Date();
              const formattedDate = timestamp.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
              const formattedTime = timestamp.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
              
              const log = {
                admin: 'Administrator Lulus.id',
                tanggal: formattedDate,
                jam: formattedTime + ' WIB',
                status: newIsValid ? 'DISETUJUI' : 'DITOLAK',
                catatan: promptNotes || (newIsValid ? 'Validasi dipulihkan.' : 'Dokumen dinonaktifkan sementara.')
              };

              return {
                ...s,
                status: newIsValid ? 'Aktif' : 'Nonaktif',
                catatanVerifikasi: promptNotes,
                riwayatVerifikasi: [log, ...(s.riwayatVerifikasi || [])]
              };
            }
            return s;
          });
          localStorage.setItem('lulus_students', JSON.stringify(updated));
        } catch (e) {
          console.error(e);
        }
      }
    } else {
      // Update academic library (documentLibrary)
      const savedDocs = localStorage.getItem('documentLibrary');
      if (savedDocs) {
        try {
          const docsList = JSON.parse(savedDocs);
          const updated = docsList.map((d: any) => {
            if (d.id === doc.id || d.verificationCode === doc.verificationCode) {
              return {
                ...d,
                isValid: newIsValid,
                status: newIsValid ? 'Publish' : 'Dicabut',
                notes: promptNotes,
                catatanVerifikasi: promptNotes
              };
            }
            return d;
          });
          localStorage.setItem('documentLibrary', JSON.stringify(updated));
        } catch (e) {
          console.error(e);
        }
      }
    }

    // Refresh display
    loadConsolidatedDocuments();
    showModal(
      'Status Validasi Diperbarui', 
      `Dokumen "${doc.verificationCode}" berhasil dinyatakan ${newIsValid ? 'VALID & AKTIF' : 'TIDAK VALID / DICABUT'}. Catatan: "${promptNotes || '-'}"`, 
      'success'
    );
  };

  // Delete a verification record completely
  const handleDeleteRecord = (doc: VerificationDocument) => {
    if (role !== 'admin') {
      showModal('Akses Ditolak', 'Hanya Administrator yang memiliki wewenang menghapus arsip digital dari basis data.', 'warning');
      return;
    }

    if (!window.confirm(`Apakah Anda yakin ingin menghapus arsip verifikasi dokumen "${doc.verificationCode}" secara permanen?\n\nTindakan ini tidak dapat dibatalkan.`)) {
      return;
    }

    if (doc.documentType === 'Formulir PPDB') {
      showModal('Gagal Menghapus', 'Dokumen PPDB terhubung langsung dengan pendaftaran siswa aktif. Untuk menonaktifkan, silakan gunakan fitur cabut validasi.', 'warning');
      return;
    }

    const savedDocs = localStorage.getItem('documentLibrary');
    if (savedDocs) {
      try {
        const docsList = JSON.parse(savedDocs);
        const filtered = docsList.filter((d: any) => d.id !== doc.id && d.verificationCode !== doc.verificationCode);
        localStorage.setItem('documentLibrary', JSON.stringify(filtered));
        
        loadConsolidatedDocuments();
        showModal('Berhasil Dihapus', 'Arsip verifikasi dokumen berhasil dihapus secara permanen.', 'success');
      } catch (e) {
        console.error(e);
      }
    }
  };

  // Helper to generate new verification code
  const handleAutoFillDocNumber = () => {
    const randomNum = Math.floor(1000 + Math.random() * 9000);
    const year = formIssueDate.split('-')[0] || '2026';
    let shortCode = 'CRT';
    if (formDocType === 'Ijazah') shortCode = 'DN-IJZ';
    else if (formDocType === 'SKL') shortCode = 'SKL-PKBM';
    else if (formDocType === 'Transkrip Nilai') shortCode = 'TR-NILAI';

    setFormDocNumber(`${shortCode}/${randomNum}/${year}`);
  };

  // Submit Registration of New Custom Document
  const handleRegisterNewDoc = (e: React.FormEvent) => {
    e.preventDefault();
    if (!formStudentId || !formDocNumber) {
      showModal('Formulir Tidak Lengkap', 'Nama Siswa dan Nomor Dokumen wajib diisi.', 'warning');
      return;
    }

    let customData = {};
    try {
      customData = JSON.parse(formCustomDataJson);
    } catch (e) {
      showModal('Format JSON Salah', 'Data tambahan (snapshot) harus berupa format JSON yang valid.', 'warning');
      return;
    }

    const studentObj = students.find(s => s.id === formStudentId);
    const studentName = studentObj ? studentObj.nama : formStudentName || 'Siswa Mandiri';
    const studentNisn = studentObj ? studentObj.nisn : formNisn || '-';
    const studentProgram = studentObj ? studentObj.program : formProgram;
    const studentKelas = studentObj ? studentObj.kelas : formKelas || 'Kelas Kesetaraan';

    // Generate Verification Code
    const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
    let randomPart = '';
    for (let i = 0; i < 6; i++) {
      randomPart += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    const year = formIssueDate.split('-')[0] || '2026';
    let prefix = 'DOC';
    if (formDocType === 'Ijazah') prefix = 'IJZ';
    else if (formDocType === 'SKL') prefix = 'SKL';
    else if (formDocType === 'Transkrip Nilai') prefix = 'TRK';
    else if (formDocType === 'Sertifikat') prefix = 'CRT';
    const generatedVerifCode = `${prefix}-${year}-${randomPart}`;

    const newDocObj = {
      id: `DOC-CUSTOM-${Date.now()}`,
      studentId: formStudentId,
      studentName,
      nisn: studentNisn,
      program: studentProgram,
      kelas: studentKelas,
      tahunLulus: year,
      documentType: formDocType,
      documentNumber: formDocNumber,
      verificationCode: generatedVerifCode,
      issueDate: formIssueDate,
      title: `${formDocType} Kesetaraan - ${studentName}`,
      description: formNotes || `Dokumen verifikasi ${formDocType} resmi siswa.`,
      file: `${formDocType.toLowerCase().replace(/\s+/g, '_')}_${studentName.toLowerCase().replace(/\s+/g, '_')}.pdf`,
      thumbnail: 'https://images.unsplash.com/photo-1589330694653-ded6df03f754?w=150&auto=format&fit=crop&q=60&ixlib=rb-4.0.3',
      status: 'Publish',
      isValid: true,
      notes: formNotes,
      uploadedBy: loggedInUser.nama || 'Administrator',
      uploadedAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
      downloads: 0,
      views: 0,
      snapshotData: {
        documentNumber: formDocNumber,
        signerName: formSignerName,
        signerRole: formSignerRole,
        notes: formNotes,
        ...customData
      }
    };

    // Save to documentLibrary
    const savedDocs = localStorage.getItem('documentLibrary');
    let docsList = [];
    if (savedDocs) {
      try { docsList = JSON.parse(savedDocs); } catch (e) {}
    }
    docsList.unshift(newDocObj);
    localStorage.setItem('documentLibrary', JSON.stringify(docsList));

    // Refresh list state
    loadConsolidatedDocuments();
    showModal('Dokumen Terverifikasi Berhasil', `Dokumen baru resmi terdaftar dengan Kode Verifikasi QR: ${generatedVerifCode}`, 'success');
    
    // Reset Form & switch back to list
    setViewState('list');
    setFormStudentId('');
    setFormDocNumber('');
    setFormNotes('');
  };

  const handleStudentSelectChange = (id: string) => {
    setFormStudentId(id);
    const stud = students.find(s => s.id === id);
    if (stud) {
      setFormStudentName(stud.nama);
      setFormNisn(stud.nisn || '');
      setFormProgram(stud.program || 'Paket C');
      setFormKelas(stud.kelas || '');
    }
  };

  const handleSimulateExport = () => {
    showModal(
      'Mengekspor Arsip Digital...',
      'Sistem sedang menyaring database verifikasi dokumen PKBM Agrabinta dan memformulasikan ke dalam spreadsheet Excel.',
      'info'
    );
    setTimeout(() => {
      showModal(
        'Ekspor Berhasil',
        `Database Bank Verifikasi Dokumen (${filteredDocs.length} berkas) berhasil diunduh secara lokal.`,
        'success'
      );
    }, 1200);
  };

  // --- FILTERED SELECTION ---
  const getFilteredDocs = () => {
    let result = [...verifiedDocs];

    // Search query
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      result = result.filter(d => 
        d.verificationCode.toLowerCase().includes(q) ||
        (d.snapshotData?.documentNumber || '').toLowerCase().includes(q) ||
        d.studentName.toLowerCase().includes(q) ||
        (d.studentNisn || '').toLowerCase().includes(q) ||
        d.documentType.toLowerCase().includes(q)
      );
    }

    // Filter by type
    if (filterType !== 'all') {
      result = result.filter(d => d.documentType === filterType);
    }

    // Filter by validation status
    if (filterStatus !== 'all') {
      const isVal = filterStatus === 'valid';
      result = result.filter(d => d.isValid === isVal);
    }

    // Filter by Year
    if (filterYear !== 'all') {
      result = result.filter(d => d.issueDate.startsWith(filterYear));
    }

    return result;
  };

  const filteredDocs = getFilteredDocs();

  // Stats Counters
  const totalVerified = verifiedDocs.length;
  const activeValid = verifiedDocs.filter(d => d.isValid).length;
  const revokedInvalid = verifiedDocs.filter(d => !d.isValid).length;
  const totalRapor = verifiedDocs.filter(d => d.documentType === 'E-Rapor').length;
  const totalPPDB = verifiedDocs.filter(d => d.documentType === 'Formulir PPDB').length;
  const totalAkademik = totalVerified - totalRapor - totalPPDB;

  return (
    <div className="flex-1 flex flex-col bg-slate-50 h-full text-[11px] overflow-hidden">
      
      {/* 1. TOP HEADER PANEL */}
      <div className="bg-white px-5 py-3 border-b border-slate-200 shrink-0">
        <div className="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
          <div>
            <span className="text-[8px] uppercase tracking-widest text-emerald-600 font-extrabold block">Modul Arsip Digital</span>
            <h1 className="text-xs sm:text-sm font-black text-slate-900 flex items-center gap-1.5 mt-0.5">
              <QrCode className="w-4 h-4 text-emerald-600" />
              Bank Verifikasi Dokumen Resmi
            </h1>
            <p className="text-[10px] text-slate-400 font-semibold mt-0.5">
              Pusat penyimpanan arsip dan verifikasi keabsahan seluruh sertifikat, ijazah, formulir, dan e-Rapor ber-QR Code Lulus.id.
            </p>
          </div>

          <div className="flex items-center gap-2">
            <button
              onClick={() => {
                loadConsolidatedDocuments();
                showModal('Sinkronisasi', 'Database verifikasi dokumen berhasil disinkronkan kembali.', 'success');
              }}
              className="p-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl transition-all cursor-pointer"
              title="Sinkronkan Data"
            >
              <RefreshCw className="w-3.5 h-3.5" />
            </button>

            {role === 'admin' && (
              <button
                onClick={() => setViewState(viewState === 'list' ? 'add' : 'list')}
                className="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-black text-[9px] flex items-center gap-1 shadow-sm transition-all cursor-pointer"
              >
                {viewState === 'list' ? (
                  <>
                    <Plus className="w-3 h-3" /> Daftarkan Dokumen Baru
                  </>
                ) : (
                  <>
                    <Layers className="w-3 h-3" /> Lihat Daftar Arsip
                  </>
                )}
              </button>
            )}
          </div>
        </div>
      </div>

      {/* 2. STATS BENTO ROW (Only visible in list state) */}
      {viewState === 'list' && (
        <div className="p-4 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3.5 shrink-0">
          {/* Card 1: Total Verified */}
          <div className="bg-white p-3.5 rounded-2xl border border-slate-200/70 shadow-3xs hover:border-slate-300 transition-all">
            <span className="text-[8px] font-black text-slate-400 uppercase tracking-wider block">Total Arsip QR</span>
            <h3 className="text-lg font-black text-slate-800 mt-1 leading-none">{totalVerified}</h3>
            <p className="text-[7.5px] text-slate-400 font-bold mt-1.5">Berkas Terverifikasi</p>
          </div>

          {/* Card 2: Valid / Aktif */}
          <div className="bg-white p-3.5 rounded-2xl border border-slate-200/70 shadow-3xs hover:border-emerald-200 transition-all relative overflow-hidden">
            <div className="absolute top-0 right-0 w-8 h-8 bg-emerald-500/5 rounded-full blur-xs -mt-2 -mr-2" />
            <span className="text-[8px] font-black text-emerald-600 uppercase tracking-wider block">Aktif & Sah</span>
            <h3 className="text-lg font-black text-emerald-600 mt-1 leading-none">{activeValid}</h3>
            <p className="text-[7.5px] text-slate-400 font-bold mt-1.5">Lolos Audit Kamera HP</p>
          </div>

          {/* Card 3: Revoked / Invalid */}
          <div className="bg-white p-3.5 rounded-2xl border border-slate-200/70 shadow-3xs hover:border-rose-200 transition-all relative overflow-hidden">
            <span className="text-[8px] font-black text-rose-500 uppercase tracking-wider block">Dicabut / Suspended</span>
            <h3 className="text-lg font-black text-rose-600 mt-1 leading-none">{revokedInvalid}</h3>
            <p className="text-[7.5px] text-slate-400 font-bold mt-1.5">Validasi Dinonaktifkan</p>
          </div>

          {/* Card 4: E-Rapor */}
          <div className="bg-white p-3.5 rounded-2xl border border-slate-200/70 shadow-3xs hover:border-slate-300 transition-all">
            <span className="text-[8px] font-black text-slate-400 uppercase tracking-wider block">E-Rapor QR</span>
            <h3 className="text-lg font-black text-slate-800 mt-1 leading-none">{totalRapor}</h3>
            <p className="text-[7.5px] text-slate-400 font-bold mt-1.5">Belajar Siswa Lulus.id</p>
          </div>

          {/* Card 5: PPDB */}
          <div className="bg-white p-3.5 rounded-2xl border border-slate-200/70 shadow-3xs hover:border-slate-300 transition-all">
            <span className="text-[8px] font-black text-slate-400 uppercase tracking-wider block">Formulir PPDB</span>
            <h3 className="text-lg font-black text-slate-800 mt-1 leading-none">{totalPPDB}</h3>
            <p className="text-[7.5px] text-slate-400 font-bold mt-1.5">Pendaftaran Calon Siswa</p>
          </div>

          {/* Card 6: Academic / Certs */}
          <div className="bg-white p-3.5 rounded-2xl border border-slate-200/70 shadow-3xs hover:border-slate-300 transition-all">
