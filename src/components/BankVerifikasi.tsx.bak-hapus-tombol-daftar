            <AlertCircle className="w-4 h-4 text-amber-600 shrink-0" />
            <div>
              <span className="font-extrabold text-amber-950 block uppercase text-[8px] tracking-wide">Akses Monitoring Guru (Read-Only)</span>
              <p className="font-medium text-amber-800 leading-normal">
                Sebagai Guru, Anda berwenang memantau keabsahan dan rincian verifikasi dokumen siswa. Otoritas untuk mengubah validasi, mencabut sertifikat, dan mendaftarkan kode QR baru sepenuhnya dibatasi untuk Administrator.
              </p>
            </div>
          </div>
        )}

        {/* VIEW: MAIN DIRECTORY LIST */}
        {viewState === 'list' && (
          <div className="flex-1 bg-white rounded-2xl border border-slate-200 shadow-3xs flex flex-col overflow-hidden">
            
            {/* Filter controls row */}
            <div className="p-3 bg-slate-50/50 border-b border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3 shrink-0">
