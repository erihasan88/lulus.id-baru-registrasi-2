                  <option value="all">Semua Status</option>
                  <option value="valid">Valid & Aktif</option>
                  <option value="invalid">Dicabut / Suspended</option>
                </select>

                {/* Reset filters */}
                {(searchQuery || filterType !== 'all' || filterStatus !== 'all' || filterYear !== 'all') && (
                  <button
                    onClick={() => {
                      setSearchQuery('');
                      setFilterType('all');
                      setFilterStatus('all');
                      setFilterYear('all');
                    }}
                    className="px-2.5 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-black text-[8px] uppercase tracking-tight transition-colors cursor-pointer"
