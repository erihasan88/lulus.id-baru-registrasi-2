                  />
                  <div>
                    <span className="block text-[11px] font-bold text-slate-800">Aktifkan Sekarang</span>
                    <span className="block text-[9px] text-slate-400 font-semibold leading-none mt-0.5">Otomatis menonaktifkan tahun ajaran aktif sebelumnya.</span>
                  </div>
                </label>
              </div>

              <div className="flex gap-2.5 pt-4 border-t border-slate-50">
                <button
                  type="button"
                  onClick={() => setShowAddAcademicYearModal(false)}
                  className="flex-1 py-2.5 bg-slate-50 hover:bg-slate-100 text-slate-500 rounded-xl font-bold transition-colors cursor-pointer"
                >
                  Batal
                </button>
                <button
                  type="submit"
                  className="flex-1 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl font-black shadow-md shadow-rose-500/10 transition-colors cursor-pointer"
                >
                  Simpan
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* MODAL: EDIT TAHUN AJARAN */}
      {editingAcademicYear && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 animate-fade-in">
          <div className="bg-white rounded-3xl border border-slate-100 shadow-2xl w-full max-w-md p-6 space-y-4 animate-scale-up">
            <div className="flex items-center justify-between border-b border-slate-50 pb-3">
              <div className="flex items-center gap-2">
                <div className="p-1.5 bg-rose-50 rounded-xl text-rose-600">
                  <Calendar className="w-5 h-5" />
                </div>
                <div>
                  <h4 className="text-xs font-extrabold text-slate-800">Edit Tahun Ajaran</h4>
                  <p className="text-[9px] text-slate-400 font-semibold">Ubah konfigurasi master tahun ajaran.</p>
                </div>
              </div>
              <button 
                onClick={() => setEditingAcademicYear(null)}
                className="p-1.5 hover:bg-slate-50 rounded-xl text-slate-400 hover:text-slate-600 transition-colors cursor-pointer"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <form onSubmit={handleEditAcademicYear} className="space-y-3 text-xs">
              <div>
                <label className="block text-[10px] font-bold text-slate-400 uppercase mb-1">
                  Tahun Ajaran <span className="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  required
                  placeholder="Contoh: 2026/2027"
                  value={editingAcademicYear.nama}
                  onChange={(e) => setEditingAcademicYear(prev => prev ? ({ ...prev, nama: e.target.value }) : null)}
                  className="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-500/10 focus:border-rose-500 font-black"
                />
              </div>

              <div>
                <label className="block text-[10px] font-bold text-slate-400 uppercase mb-1">
                  Semester <span className="text-rose-500">*</span>
                </label>
                <select
                  value={editingAcademicYear.semester}
                  onChange={(e) => setEditingAcademicYear(prev => prev ? ({ ...prev, semester: e.target.value as any }) : null)}
                  className="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-500/10 focus:border-rose-500 font-bold"
                >
                  <option value="Ganjil">Ganjil</option>
                  <option value="Genap">Genap</option>
                </select>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-[10px] font-bold text-slate-400 uppercase mb-1">
                    Tanggal Mulai
                  </label>
                  <input
                    type="date"
                    value={editingAcademicYear.tanggalMulai}
                    onChange={(e) => setEditingAcademicYear(prev => prev ? ({ ...prev, tanggalMulai: e.target.value }) : null)}
                    className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-500/10 focus:border-rose-500 font-bold"
                  />
                </div>
                <div>
                  <label className="block text-[10px] font-bold text-slate-400 uppercase mb-1">
                    Tanggal Selesai
                  </label>
                  <input
                    type="date"
                    value={editingAcademicYear.tanggalSelesai}
                    onChange={(e) => setEditingAcademicYear(prev => prev ? ({ ...prev, tanggalSelesai: e.target.value }) : null)}
                    className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-500/10 focus:border-rose-500 font-bold"
                  />
                </div>
              </div>

              <div className="pt-2">
                <label className="flex items-center gap-2 cursor-pointer bg-slate-50 p-3 rounded-xl border border-slate-100">
                  <input
                    type="checkbox"
                    checked={editingAcademicYear.aktif}
                    onChange={(e) => setEditingAcademicYear(prev => prev ? ({ ...prev, aktif: e.target.checked }) : null)}
                    className="w-4 h-4 text-rose-600 focus:ring-rose-500 border-slate-300 rounded cursor-pointer"
                  />
                  <div>
                    <span className="block text-[11px] font-bold text-slate-800">Aktifkan Sekarang</span>
                    <span className="block text-[9px] text-slate-400 font-semibold leading-none mt-0.5">Otomatis menonaktifkan tahun ajaran aktif sebelumnya.</span>
                  </div>
                </label>
              </div>

              <div className="flex gap-2.5 pt-4 border-t border-slate-50">
                <button
                  type="button"
                  onClick={() => setEditingAcademicYear(null)}
                  className="flex-1 py-2.5 bg-slate-50 hover:bg-slate-100 text-slate-500 rounded-xl font-bold transition-colors cursor-pointer"
                >
                  Batal
                </button>
                <button
                  type="submit"
                  className="flex-1 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl font-black shadow-md shadow-rose-500/10 transition-colors cursor-pointer"
                >
                  Simpan Perubahan
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {printingStudent && (
        <FormulirPendaftaranModal 
          student={printingStudent} 
          onClose={() => setPrintingStudent(null)} 
          showModal={showModal} 
        />
      )}

        </div>

      </div>

    </div>
  );
}
