                    showModal('Import Berhasil', `${successCount} Capaian Pembelajaran (CP) baru berhasil di-import.`, 'success');
                    setShowImportCpModal(false);
                  } catch (err) {
                    showModal('Error Parse', 'Terjadi kesalahan saat memproses data teks.', 'warning');
                  }
                }}
