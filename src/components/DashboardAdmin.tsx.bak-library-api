                    return;
                  }

                  try {
                    const lines = importCsvText.split(/\r?\n/);
                    let successCount = 0;
                    const parsedCps: any[] = [];

                    lines.forEach((line, index) => {
                      if (!line.trim()) return;
                      
                      // Support both semi-colon and comma separators
                      let parts = line.split(',');
                      if (parts.length < 3) {
                        parts = line.split(';');
                      }

                      // Clean quotes
                      parts = parts.map(p => p.replace(/^["']|["']$/g, '').trim());

                      // Skip header if matches
                      const isHeader = parts.some(p => 
                        ['kode_cp', 'program', 'fase', 'subject', 'mata pelajaran', 'deskripsi', 'elemen'].includes(p.toLowerCase())
                      );
