    );
  },

  /**
   * Menyimpan kehadiran siswa secara massal
   */
  async saveGuruAgendaAttendance(
    agendaId: string,
    records: Array<{
      siswa: number;
      status: 'HADIR' | 'IZIN' | 'SAKIT' | 'ALFA';
      catatan_guru?: string;
    }>
  ): Promise<any> {
    return fetchWithAuth(
      `/api/guru/agenda-wajib/${agendaId}/attendance/`,
      {
        method: 'POST',
        body: JSON.stringify({ records }),
      }
    );
  },

  /**
   * Mendapatkan daftar pengajuan izin dan sakit
   */
  async getGuruPengajuanIzin(
    status?: 'MENUNGGU' | 'DISETUJUI' | 'DITOLAK'
  ): Promise<any[]> {
    const query = status
      ? `?status=${encodeURIComponent(status)}`
      : '';

    return fetchWithAuth(
      `/api/guru/pengajuan-izin/${query}`
    );
  },

  /**
   * Menyetujui atau menolak pengajuan izin/sakit
   */
  async verifyGuruPengajuanIzin(
    id: string,
    status: 'DISETUJUI' | 'DITOLAK',
    catatanVerifikasi: string = ''
  ): Promise<any> {
    return fetchWithAuth(
      `/api/guru/pengajuan-izin/${id}/verify/`,
      {
        method: 'PATCH',
        body: JSON.stringify({
          status,
          catatan_verifikasi: catatanVerifikasi,
        }),
      }
    );
  },


