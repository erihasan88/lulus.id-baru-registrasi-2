  // ==========================
  // SKK SISWA GURU
  // ==========================

  async getGuruStudentCompetencies(
    params?: {
      status?: string;
      siswa?: string;
      mata_pelajaran?: string;
    }
  ): Promise<any[]> {
    const query = new URLSearchParams();

    if (params?.status) {
      query.set('status', params.status);
    }

    if (params?.siswa) {
      query.set('siswa', params.siswa);
    }

    if (params?.mata_pelajaran) {
      query.set(
        'mata_pelajaran',
        params.mata_pelajaran
      );
    }

    const suffix = query.toString()
      ? `?${query.toString()}`
      : '';

    return fetchWithAuth(
      `/api/guru/skk/student-competencies/${suffix}`
    );
  },

  async updateGuruStudentCompetency(
    id: string,
    data: {
      status?: 'belum' | 'proses' | 'tercapai';
      nilai?: number | null;
      catatan_guru?: string;
